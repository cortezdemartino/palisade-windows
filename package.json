{
  "name": "@palisade/desktop",
  "private": true,
  "version": "0.3.0",
  "description": "Windows desktop client for Palisade",
  "license": "Apache-2.0",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "electron-builder --win nsis --x64 --publish never",
    "package:dir": "electron-builder --win dir --x64 --publish never",
    "check": "npm test && node --check src/main.cjs && node --check src/updates/updater.cjs",
    "release:sign": "node scripts/sign-release.cjs",
    "test:window-controls": "node scripts/test-window-controls.cjs",
    "build:assist": "node scripts/build-assist.cjs",
    "test:assist-native": "cargo fmt --check --manifest-path native/assist/Cargo.toml && cargo clippy --locked --manifest-path native/assist/Cargo.toml --all-targets --all-features -- -D warnings && cargo test --locked --manifest-path native/assist/Cargo.toml && cargo test --locked --manifest-path native/assist/Cargo.toml --all-features",
    "test:assist-process": "node --test tests/assist-guardian-process.native.cjs tests/assist-live-process.native.cjs && node scripts/test-assist-features.cjs",
    "test:assist-capture": "node scripts/test-assist-capture.cjs",
    "test:assist-peer": "node scripts/test-assist-peer.cjs",
    "verify:assist-package": "node scripts/verify-assist-package.cjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "org.onyxops.palisade",
    "productName": "Palisade",
    "copyright": "Copyright Â© 2026 Onyx Operations Group",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon-unread.png",
      "assets/update-public-key.pem",
      "assets/update-key-transitions.json",
      "package.json",
      "THIRD-PARTY-NOTICES.md",
      "!src/updates/install.ps1",
      "!src/updates/downloader.cjs"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Palisade-Setup-${version}-${arch}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "beforePack": "scripts/before-pack.cjs",
    "extraResources": [
      {
        "from": ".assist",
        "to": "assist",
        "filter": ["Palisade-Assist.exe", "THIRD-PARTY-NOTICES.txt", "RUST-COPYRIGHT.html", "licenses/**/*"]
      },
      {
        "from": ".manager/Palisade-Manager.exe",
        "to": "manager/Palisade-Manager.exe"
      },
      {
        "from": "assets/icon-normal.png",
        "to": "notification-icon.png"
      }
    ]
  }
}

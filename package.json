{
  "name": "@palisade/desktop",
  "private": true,
  "version": "0.2.1",
  "description": "Windows desktop client for Palisade",
  "license": "Apache-2.0",
  "main": "src/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "package:win": "electron-builder --win nsis --x64 --publish never",
    "package:dir": "electron-builder --win dir --x64 --publish never",
    "check": "npm test && node --check src/main.cjs && node --check src/updates/updater.cjs",
    "release:sign": "node scripts/sign-release.cjs"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "org.onyxops.palisade",
    "productName": "Palisade",
    "copyright": "Copyright © 2026 Onyx Operations Group",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/update-public-key.pem",
      "package.json",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Palisade-Setup-${version}-${arch}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
